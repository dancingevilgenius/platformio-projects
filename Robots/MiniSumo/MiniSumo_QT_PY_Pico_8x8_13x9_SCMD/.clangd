# Clangd uses host Clang, not xtensa-esp32-elf-g++. Drop GCC/ESP32-only
# flags that Clang rejects, then let --query-driver supply toolchain includes.
CompileFlags:
  Add:
    - -DARDUINO=10812
    - -DESP32
    - -DARDUINO_ARCH_ESP32
    - -IC:/Users/Carlos/.platformio/packages/framework-arduinoespressif32/cores/esp32
    - -IC:/Users/Carlos/.platformio/packages/framework-arduinoespressif32/variants/adafruit_qtpy_esp32
    - -IC:/Users/Carlos/.platformio/packages/framework-arduinoespressif32/libraries/Wire/src
    - -IC:/Users/Carlos/.platformio/packages/framework-arduinoespressif32/libraries/WiFi/src
    - -IC:/Users/Carlos/.platformio/packages/framework-arduinoespressif32/libraries/LittleFS/src
    - -IC:/Users/Carlos/.platformio/packages/framework-arduinoespressif32/libraries/FS/src
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/ArduinoJson/src
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/Adafruit_IS31FL3741_Library
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/Adafruit_GFX_Library
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/Adafruit_BusIO
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/ESPAsyncWebServer/src
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/AsyncTCP/src
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/DFRobot_MatrixLidar
    - -IC:/Users/Carlos/Documents/Programming/VSCode/platformio-projects/libraries/Serial_Controlled_Motor_Driver/src
  Remove:
    - -mlongcalls
    - -mlong-calls
    - -mtext-section-literals
    - -mdisable-hardware-atomics
    - -mfix-esp32-psram-cache-issue
    - -mfix-esp32-psram-cache-strategy=*
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-jump-tables
    - -freorder-blocks
    - -fno-shrink-wrap
    - -fipa-pta
    - -free
    - -Wno-frame-address
    - -Wno-error=unused-but-set-variable
    - -Wno-error=unused-function
    - -Wno-error=unused-variable
    - -Wno-error=deprecated-declarations

Diagnostics:
  Suppress:
    - drv_unknown_argument
    - unknown-argument
